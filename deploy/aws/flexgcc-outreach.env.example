DB_CONN_MAX_AGE=60

DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/flexgcc

GOOGLE_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE
