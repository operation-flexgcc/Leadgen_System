DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=False

DATABASE_URL=postgresql://flexgcc:flexgcc@db:5432/flexgcc

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
REQUIRE_PREPROVISIONED_USERS=True

# New API access tokens persist until the user revokes them.
# The signing settings below remain required temporarily for old JWT compatibility.
API_TOKEN_ISSUER=flexgcc-outreach
API_TOKEN_AUDIENCE=flexgcc-outreach-api
# Optional separate signing secret. If blank or omitted, DJANGO_SECRET_KEY is used.
API_TOKEN_SIGNING_KEY=

# These bootstrap the first privileged users. System admins can add everyone else in the app.
SYSTEM_ADMIN_EMAILS=founder@example.com
MANAGER_EMAILS=
