# FlexGCC Outreach production environment
# Copy to /var/www/leadgen/repo/.env (or /etc/flexgcc-outreach.env), replace
# every REPLACE_* value, and chmod 600.
# Keep values shell-safe because both systemd and deploy.sh read this file.

# Django runtime
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
DJANGO_ALLOWED_HOSTS=leadgen.flexgcc.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://leadgen.flexgcc.com
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

# PostgreSQL. URL-encode special characters in the password.
DATABASE_URL=postgresql://flexgcc:REPLACE_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/flexgcc
DB_CONN_MAX_AGE=60

# Google OAuth web application credentials
GOOGLE_OAUTH_CLIENT_ID=283830390276-q12chge3tnv1201it0ua0a2jun1kd3dk.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_ROTATED_GOOGLE_CLIENT_SECRET
GOOGLE_ALLOWED_DOMAINS=flexgcc.com
REQUIRE_PREPROVISIONED_USERS=True

# New API access tokens persist until the user revokes them.
# Keep these signing settings unchanged while old JWTs remain in circulation.
API_TOKEN_ISSUER=flexgcc-outreach
API_TOKEN_AUDIENCE=flexgcc-outreach-api
# Recommended in production: generate a separate long random signing value.
API_TOKEN_SIGNING_KEY=replace-with-another-long-random-value

# Bootstrap access. Keep at least one real system administrator email here.
SYSTEM_ADMIN_EMAILS=gopala.krishnan@flexgcc.com
MANAGER_EMAILS=gopala.krishnan@flexgcc.com

# Native virtualenv deployment controls used by ./deploy.sh
FLEXGCC_SERVICE_NAME=leadgen
FLEXGCC_RESTART_SERVICE=True
FLEXGCC_RUN_TESTS=False
FLEXGCC_HEALTHCHECK_URL=http://localhost/health/
FLEXGCC_HEALTHCHECK_HOST=leadgen.flexgcc.com
FLEXGCC_HEALTHCHECK_UNIX_SOCKET=/run/leadgen/leadgen.sock
FLEXGCC_HEALTHCHECK_ATTEMPTS=30
FLEXGCC_HEALTHCHECK_DELAY_SECONDS=2
FLEXGCC_DEPLOY_LOCK_FILE=/tmp/flexgcc-outreach-deploy.lock
